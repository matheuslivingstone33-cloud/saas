# =============================================================================
# PROSPECTOR AI — .env.example
# Fases 0-6 rodam SEM NENHUMA CHAVE. So preencha as chaves reais na FASE 7.
# Copie para .env:  cp .env.example .env
# =============================================================================

# --- Ambiente ----------------------------------------------------------------
# `producao` liga as travas de seguranca (ver Segredos abaixo). Em `dev` e
# `test` elas ficam desligadas para o projeto rodar sem configurar nada.
APP_ENV=dev

# --- Infra (o docker compose ja sobe com defaults; deixe vazio para usar) -----
DATABASE_URL=
REDIS_URL=

# Banco em producao (docker-compose.prod.yml recusa subir sem estes dois).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=prospector

# --- Segredos (Etapa 8) ------------------------------------------------------
# Gere cada um com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Em APP_ENV=producao a aplicacao RECUSA SUBIR se o JWT_SECRET estiver com o
# valor de desenvolvimento ou tiver menos de 32 caracteres. Isso e proposital:
# esquecer este campo nao produziria sintoma nenhum — so deixaria qualquer
# pessoa que leia o repositorio assinar um token valido para qualquer conta.
APP_SECRET=
JWT_SECRET=

# HMAC dos webhooks de entrada (/v1/inbound/email e /v1/inbound/retorno).
# VAZIO FECHA a rota, em vez de abrir: um webhook que "funciona" porque ninguem
# definiu a chave aceitaria o mundo inteiro — e uma resposta forjada nao suja so
# a thread, ela move a mira do aprendizado daquele cliente (Etapa 7).
# Configure o mesmo valor no provedor de e-mail quando ligar EMAIL_MODE=real.
WEBHOOK_SECRET=

# --- Selecao de provedores ---------------------------------------------------
# PROVIDER_MODE e o padrao global. Cada *_MODE vazio herda o global.
# Na Fase 7 vire UM POR VEZ para "real" e rode o smoke test daquele provedor.
PROVIDER_MODE=mock
PLACES_MODE=mock
LLM_MODE=mock
EMAIL_MODE=mock
WHATSAPP_MODE=mock
SEARCH_MODE=mock
BILLING_MODE=mock

# --- Chaves reais — DEIXAR EM BRANCO ate a Fase 7 ----------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_MAPS_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
SES_FROM_EMAIL=
WHATSAPP_BSP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_BUSINESS_ID=
STRIPE_SECRET_KEY=

# --- Receita Federal / CNPJ: dado aberto, SEM CHAVE --------------------------
RECEITA_DATASET_PATH=data/receita/cnpj_sample.csv

# --- Modelos e limites -------------------------------------------------------
LLM_MODEL=claude-opus-5
EMBEDDING_DIM=384
OUTBOX_DIR=outbox
LOG_LEVEL=INFO

# --- Financeiro (Fase 5/7) ---------------------------------------------------
# Provedores cobram em USD; o cliente paga em BRL. Atualize em producao.
USD_BRL=5.40

# --- Compliance (Fase 4) — obrigatorio em producao ---------------------------
URL_PUBLICA=https://app.prospector.local
URL_API_PUBLICA=http://localhost:8000
ENCARREGADO_EMAIL=privacidade@prospector.local
RETENCAO_LEADS_DIAS=180
RETENCAO_MENSAGENS_DIAS=365

# --- Limites de envio (warmup: comece baixo e suba ao longo de semanas) ------
MAX_ENVIOS_POR_CAMPANHA_DIA=200
MAX_ENVIOS_POR_USUARIO_DIA=500

# --- Guardrails de compliance (Fase 4 endurece) ------------------------------
# WhatsApp frio para PF e PROIBIDO. Template so sob flag explicita.
WHATSAPP_TEMPLATE_ENABLED=false
B2B_ONLY=true
